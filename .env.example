# LegalEase AI — environment variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values for local development.
# NEVER commit .env — it is listed in .gitignore.
# For production (Vercel), add these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── OPTIONAL — production values shown ───────────────────────────────────────

# Gemini model name (default: gemini-2.5-flash)
# Supported: gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash |
#            gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Primary frontend origin added to the FastAPI CORS allow-list.
# In production set this to your Streamlit Cloud URL, e.g.:
#   FRONTEND_URL=https://your-app.streamlit.app
FRONTEND_URL=http://localhost:8501

# Additional CORS origins (comma-separated, no spaces around commas).
# Use this to add extra origins without changing code.
# Example: ALLOWED_ORIGINS=https://your-app.streamlit.app,https://your-domain.com
ALLOWED_ORIGINS=

# URL the Streamlit frontend uses to reach the FastAPI backend.
# Local development:  http://127.0.0.1:8000
# Production:         https://your-vercel-project.vercel.app
LEGALEASE_API_URL=http://127.0.0.1:8000

# Application metadata
APP_NAME=LegalEase
APP_VERSION=1.0.0

# Local-only uvicorn bind address (not used on Vercel)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
